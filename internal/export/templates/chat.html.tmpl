<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="tgexport">
<title>{{.Title}}</title>
<style>
:root{
  --bg:#e7ebf0;--panel:#ffffff;--bubble:#ffffff;--mine:#e1ffc7;--text:#111827;--muted:#6b7280;
  --accent:#2a8bd8;--border:#d9dee5;--code:#f3f4f6;--chip:#eef2f7;--shadow:0 1px 1px rgba(0,0,0,.08);
}
@media (prefers-color-scheme:dark){:root{
  --bg:#0e1621;--panel:#17212b;--bubble:#182533;--mine:#2b5278;--text:#e5e7eb;--muted:#8b9aab;
  --accent:#6ab3f3;--border:#24313f;--code:#0f1a24;--chip:#22303e;--shadow:none;
}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:15px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
header{position:sticky;top:0;z-index:2;background:var(--panel);border-bottom:1px solid var(--border);padding:10px 16px}
.head{max-width:820px;margin:0 auto;display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.head h1{font-size:17px;margin:0;flex:1 1 auto;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.meta{color:var(--muted);font-size:13px}
#q{flex:1 1 200px;max-width:280px;padding:7px 10px;border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--text);font:inherit}
main{max-width:820px;margin:0 auto;padding:8px 12px 40px}
.day{position:sticky;top:58px;z-index:1;text-align:center;margin:14px 0 6px}
.day span{display:inline-block;background:rgba(0,0,0,.25);color:#fff;padding:3px 10px;border-radius:12px;font-size:13px}
.msg{display:flex;margin:2px 0}
.msg.mine{justify-content:flex-end}
.bubble{max-width:min(560px,85%);background:var(--bubble);border-radius:12px;padding:6px 10px 6px;box-shadow:var(--shadow);overflow-wrap:anywhere}
.mine .bubble{background:var(--mine)}
.msg.first{margin-top:8px}
.name{font-weight:600;font-size:14px;margin-bottom:2px}
.c0{color:#e17076}.c1{color:#7bc862}.c2{color:#e5ca77}.c3{color:#65aadd}.c4{color:#a695e7}.c5{color:#ee7aae}.c6{color:#6ec9cb}.c7{color:#faa774}
.fwd{font-size:13px;color:var(--accent);margin-bottom:2px}
.reply{display:block;border-left:3px solid var(--accent);padding:1px 8px;margin:2px 0 4px;font-size:13px;color:inherit;text-decoration:none;background:var(--chip);border-radius:4px}
.reply b{color:var(--accent);font-weight:600}
.reply span{color:var(--muted);display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.media{color:var(--muted);font-style:italic}
.text{white-space:pre-wrap}
.foot{float:right;margin:4px 0 0 10px;font-size:12px;color:var(--muted)}
.reacts{clear:both;display:flex;gap:4px;flex-wrap:wrap;padding-top:4px}
.reacts span{background:var(--chip);border-radius:10px;padding:0 7px;font-size:13px}
.service{text-align:center;margin:8px 0}
.service span{display:inline-block;background:rgba(0,0,0,.18);color:#fff;padding:3px 10px;border-radius:12px;font-size:13px}
a{color:var(--accent)}
code{background:var(--code);padding:1px 4px;border-radius:4px;font:13px ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
pre{background:var(--code);padding:8px;border-radius:6px;overflow-x:auto;white-space:pre;margin:4px 0}
pre code{padding:0;background:none}
blockquote{margin:4px 0;padding-left:8px;border-left:3px solid var(--accent)}
.spoiler{background:var(--muted);color:transparent;border-radius:3px;cursor:pointer}
.spoiler.open{background:none;color:inherit}
.accent{color:var(--accent)}
:target .bubble{outline:2px solid var(--accent)}
.hidden{display:none}
footer{text-align:center;color:var(--muted);font-size:12px;padding:20px}
</style>
</head>
<body>
<header><div class="head">
  <h1>{{.Title}}</h1>
  <div class="meta">{{.Type}} · {{.Count}} messages{{if .Period}} · {{.Period}}{{end}}</div>
  <input id="q" type="search" placeholder="Search…" aria-label="Search messages">
</div></header>
<main>
{{- range .Days}}
<section class="d">
<div class="day"><span>{{.Date}}</span></div>
{{- range .Messages}}
{{- if .Service}}
<div class="service m" id="msg-{{.ID}}"><span>{{.Author}} {{.Body}} · {{.Time}}</span></div>
{{- else}}
<div class="msg m{{if .Mine}} mine{{end}}{{if .ShowName}} first{{end}}" id="msg-{{.ID}}"><div class="bubble">
{{- if .ShowName}}<div class="name c{{.Color}}">{{.Author}}</div>{{end}}
{{- if .Forwarded}}<div class="fwd">Forwarded from {{.Forwarded}}</div>{{end}}
{{- with .Reply}}<a class="reply" href="#msg-{{.ID}}"><b>{{.Author}}</b>{{if .Snippet}}<span>{{.Snippet}}</span>{{end}}</a>{{end}}
{{- if .Media}}<div class="media">{{.Media}}</div>{{end}}
{{- if .Body}}<span class="text">{{.Body}}</span>{{end}}
<span class="foot" title="{{.FullTime}}">{{if .Edited}}<span title="edited {{.Edited}}">edited · </span>{{end}}{{.Time}}</span>
{{- if .Reactions}}<div class="reacts">{{range .Reactions}}<span>{{.}}</span>{{end}}</div>{{end}}
</div></div>
{{- end}}
{{- end}}
</section>
{{- end}}
</main>
<footer>Generated by <a href="https://github.com/antalkon/tgexport">tgexport</a> · {{.Generated}}</footer>
<script>
(function(){
  var q=document.getElementById('q'),msgs=[].slice.call(document.querySelectorAll('.m')),days=[].slice.call(document.querySelectorAll('.d'));
  q.addEventListener('input',function(){
    var v=q.value.trim().toLowerCase();
    msgs.forEach(function(m){m.classList.toggle('hidden',v!==''&&m.textContent.toLowerCase().indexOf(v)<0)});
    days.forEach(function(d){d.classList.toggle('hidden',!d.querySelector('.m:not(.hidden)'))});
  });
  document.addEventListener('click',function(e){if(e.target.classList.contains('spoiler'))e.target.classList.add('open')});
})();
</script>
</body>
</html>
